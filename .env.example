# Copie para .env e preencha. Nunca versionar o .env.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
# Endereços (com http:// ou https://) de onde o sistema é acessado, separados por vírgula.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Coloque 1 quando o sistema estiver atrás de HTTPS.
HTTPS=0

DB_NAME=uruz
DB_USER=uruz
DB_PASSWORD=troque-a-senha-do-banco

WEB_PORT=8000

# E-mail para enviar as cobranças. Sem EMAIL_HOST o botão de enviar fica desativado.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
# Remetente que aparece para a empresa, ex.: Play Participações <cobranca@playparticipacoes.com.br>
EMAIL_FROM=
# Opcional: para onde vão as respostas das empresas.
EMAIL_RESPONDER_PARA=

# Para simular o envio sem mandar de verdade (teste local):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Pix para receber as cobranças (QR Code gerado pelo sistema). Sem PIX_CHAVE o Pix não aparece.
# A chave pode ser CNPJ, e-mail, telefone (+5563...) ou chave aleatória.
PIX_CHAVE=
PIX_NOME=
PIX_CIDADE=

# Exportação para o agente de relatórios (ver docs/EXPORTACAO-HERMES.md). Senhas e chaves só no servidor, nunca no git.
HERMES_RO_PASSWORD=
HERMES_EXPORT_DIR=exports
GOOGLE_SA_JSON=
GOOGLE_SHARED_DRIVE_ID=
