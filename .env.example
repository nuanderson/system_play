# Copie para .env e preencha. Nunca versionar o .env.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
# Endereços (com http:// ou https://) de onde o sistema é acessado, separados por vírgula.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Coloque 1 quando o sistema estiver atrás de HTTPS.
HTTPS=0

DB_NAME=uruz
DB_USER=uruz
DB_PASSWORD=troque-a-senha-do-banco

WEB_PORT=8000

# E-mail para enviar as cobranças. Sem EMAIL_HOST o botão de enviar fica desativado.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
# Remetente que aparece para a empresa, ex.: Play Participações <cobranca@playparticipacoes.com.br>
EMAIL_FROM=
# Opcional: para onde vão as respostas das empresas.
EMAIL_RESPONDER_PARA=

# Para simular o envio sem mandar de verdade (teste local):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
